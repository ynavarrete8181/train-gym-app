# REVIVE SPORTS — desarrollo local (simulador iOS)
# Copia este archivo como .env en tu Mac y ajusta los valores según tu entorno.
# No almacenes credenciales privadas en variables EXPO_PUBLIC_: se incluyen en el cliente.

# Laravel local: el simulador de iOS puede acceder al servidor de la Mac mediante 127.0.0.1.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8002

# Configura Reverb solo si lo ejecutas localmente y la app lo necesita.
# No apuntar a servicios de WebSocket de producción desde desarrollo.
# EXPO_PUBLIC_REVERB_APP_KEY=clave_publica_de_desarrollo
# EXPO_PUBLIC_REVERB_HOST=127.0.0.1
# EXPO_PUBLIC_REVERB_PORT=8080
# EXPO_PUBLIC_REVERB_SCHEME=http

# Códigos internos/credenciales: gestionarlos en el backend.
# Evita EXPO_PUBLIC_ORQUESTADOR_INTERNAL_CONSUMER_CODE si es una credencial.
